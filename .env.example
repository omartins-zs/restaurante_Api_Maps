# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE - RESTAURANT FINDER (GOOGLE MAPS & PLACES API)
# ==============================================================================
# Instruções:
# 1. Copie este arquivo para `.env`: cp .env.example .env
# 2. Por padrão, o bloco # LOCAL está ativo.
# 3. Para rodar via Docker Compose, comente o bloco # LOCAL e descomente # DOCKER.
# ==============================================================================

APP_NAME="Restaurant Finder Maps"
APP_ENV=local
APP_DEBUG=true

# Chave da API Google Maps JavaScript & Places API (Opcional: possui fallback inteligente com dados simulados)
REACT_APP_GOOGLE_API_KEY=

# ==============================================================================
# LOCAL (Ativo por padrão - Laragon / Execução Nativa)
# ==============================================================================
APP_URL=http://localhost:3000
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=restaurante_maps
DB_USERNAME=root
DB_PASSWORD=

# ==============================================================================
# DOCKER (Descomente abaixo e comente o bloco LOCAL para usar Docker Compose)
# ==============================================================================
# APP_URL=http://localhost:8080
# DB_CONNECTION=mysql
# DB_HOST=mysql
# DB_PORT=3306
# DB_DATABASE=restaurante_maps
# DB_USERNAME=restaurante_user
# DB_PASSWORD=secret
